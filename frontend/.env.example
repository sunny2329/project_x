# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app: never put secrets here.

# Backend base URL. Android emulator reaches the host machine at 10.0.2.2; iOS simulator uses localhost.
# A physical device needs your machine's LAN IP (e.g. http://192.168.1.20:4000).
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Prepended to phone numbers typed without a "+country code".
EXPO_PUBLIC_DEFAULT_COUNTRY_CODE=+91

# Google Sign-In: the OAuth *Web* client ID (must also be in the backend's GOOGLE_CLIENT_IDS)
# and the iOS client ID. If empty, tapping Google shows a "not configured" message.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Build-time only (iOS): reversed iOS client ID, e.g. com.googleusercontent.apps.1234-abcd
GOOGLE_IOS_URL_SCHEME=
