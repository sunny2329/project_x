  "notes": {
    "s_auth": {
      "page": "auth",
      "text": "Flow\n• Welcome › Get started → Sign up\n• Welcome › Log in → Log in\n• Google / Apple works only for existing accounts\n• Claim screen shows only if guest matches match your phone number\n• Forgot password signs you out on every device",
      "w": 360,
      "x": -440,
      "y": 0
    },
    "s_home": {
      "page": "home",
      "text": "Flow\n• Tab bar: Home · Tournaments · + New match · Chats · Profile\n• Live strip card → Spectator view\n• Result card → Match result\n• Post → Post & comments\n• Search → Another player → Message → Chat thread",
      "w": 360,
      "x": -440,
      "y": 0
    },
    "s_sc": {
      "page": "scoring",
      "text": "Flow\n• + in tab bar → pick sport\n• Start match → live scoring\n• ⋯ menu → retire, walkover (before first point), abandon, add scorer\n• Finish appears when the engine says complete\n• Result posts to the feed and moves ratings",
      "w": 360,
      "x": -440,
      "y": 0
    },
    "s_sports": {
      "page": "sports",
      "text": "Same layout for every sport\n• Top: games / sets history\n• Callout: Match point, Deuce, 4-7-2\n• Two side buttons, labels from actions[]\n• Undo always one tap\nBadminton lives on the scoring page",
      "w": 360,
      "x": -440,
      "y": 0
    },
    "s_to": {
      "page": "torg",
      "text": "Lifecycle\nDraft → Registration open → closed → Drawn → In progress → Completed\n• Draw preview can reshuffle until saved\n• Reset draw until first match is played\n• Winners advance automatically",
      "w": 360,
      "x": -440,
      "y": 0
    },
    "s_tp": {
      "page": "tplayer",
      "text": "Flow\n• Tournaments tab → list → tournament → event\n• Register → entry pending until approved\n• My matches shows Ready / Live fixtures and scorer duties\n• Ready + assigned scorer → Start → live scoring",
      "w": 360,
      "x": -440,
      "y": 0
    },
