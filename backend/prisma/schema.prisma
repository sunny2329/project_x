generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model admin_analytics_daily {
  id             BigInt     @id @default(autoincrement())
  analytics_date DateTime   @db.Date
  sport_id       BigInt?
  metric_type_id BigInt
  metric_value   Decimal    @default(0) @db.Decimal(18, 2)
  created_at     DateTime   @default(now()) @db.Timestamp(6)
  updated_at     DateTime   @default(now()) @db.Timestamp(6)
  mst_sport      mst_sport? @relation(fields: [sport_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_admin_analytics_daily_sport")

  @@unique([analytics_date, sport_id, metric_type_id], map: "uq_admin_analytics_daily")
}

model admin_audit_log {
  id             BigInt   @id @default(autoincrement())
  user_id        String   @db.Uuid
  action_type_id BigInt
  entity_type_id BigInt?
  entity_id      String?  @db.Uuid
  old_value      Json?
  new_value      Json?
  ip_address     String?  @db.Inet
  user_agent     String?
  created_at     DateTime @default(now()) @db.Timestamp(6)
  usr_user       usr_user @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_admin_audit_log_user")
}

model auth_account_verification {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String    @db.Uuid
  verification_type Int       @default(1)
  target_value      String?   @db.VarChar(255)
  verification_hash String?   @db.VarChar(255)
  expires_at        DateTime? @db.Timestamptz(6)
  verified_at       DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  usr_user          usr_user  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_account_verification_user")
}

model auth_device {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String    @db.Uuid
  device_identifier String    @db.VarChar(255)
  device_type       String?   @db.VarChar(30)
  device_name       String?   @db.VarChar(255)
  os_name           String?   @db.VarChar(100)
  os_version        String?   @db.VarChar(50)
  app_version       String?   @db.VarChar(50)
  push_token        String?
  is_active         Boolean   @default(true)
  last_seen_at      DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)
  usr_user          usr_user  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_auth_device_user")

  @@unique([user_id, device_identifier], map: "uq_auth_device")
}

model auth_login_log {
  id                 BigInt    @id @default(autoincrement())
  user_id            String?   @db.Uuid
  username           String?   @db.VarChar(50)
  phone_country_code String?   @db.VarChar(5)
  phone_number       String?   @db.VarChar(20)
  login_method       Int       @default(1)
  action             Int       @default(1)
  status             Int       @default(1)
  failure_reason     String?   @db.VarChar(255)
  ip_address         String?   @db.Inet
  user_agent         String?
  device_id          String?   @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  usr_user           usr_user? @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_login_log_user")
}

model auth_otp {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String?   @db.Uuid
  phone_country_code String    @db.VarChar(5)
  phone_number       String    @db.VarChar(20)
  otp_hash           String    @db.VarChar(255)
  purpose            Int       @default(1)
  attempt_count      Int       @default(0) @db.SmallInt
  max_attempts       Int       @default(5) @db.SmallInt
  expires_at         DateTime  @db.Timestamptz(6)
  verified_at        DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  usr_user           usr_user? @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_auth_otp_user")
}

model auth_password_history {
  id            BigInt   @id @default(autoincrement())
  user_id       String   @db.Uuid
  password_hash String   @db.VarChar(255)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  usr_user      usr_user @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_password_history_user")
}

model auth_password_reset {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @db.VarChar(255)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  usr_user   usr_user  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_password_reset_user")
}

model auth_session {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String    @db.Uuid
  refresh_token_hash String    @db.VarChar(255)
  device_id          String?   @db.Uuid
  ip_address         String?   @db.Inet
  user_agent         String?
  expires_at         DateTime  @db.Timestamptz(6)
  last_used_at       DateTime? @db.Timestamptz(6)
  revoked_at         DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  usr_user           usr_user  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_auth_session_user")
}

model match_correction {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  match_id           String            @db.Uuid
  score_event_id     String            @unique(map: "uq_match_correction_event") @db.Uuid
  correction_type_id BigInt
  reason             String?
  corrected_by       String            @db.Uuid
  created_at         DateTime          @default(now()) @db.Timestamp(6)
  match_score_event  match_score_event @relation(fields: [score_event_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_correction_event")
  match_master       match_master      @relation(fields: [match_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_correction_match")
  usr_user           usr_user          @relation(fields: [corrected_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_correction_user")
}

model match_master {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sport_id               BigInt
  format_id              BigInt?
  scoring_id             BigInt?
  created_by             String                   @db.Uuid
  match_type_id          BigInt
  status_id              BigInt
  scheduled_at           DateTime?                @db.Timestamp(6)
  started_at             DateTime?                @db.Timestamp(6)
  completed_at           DateTime?                @db.Timestamp(6)
  created_at             DateTime                 @default(now()) @db.Timestamp(6)
  updated_at             DateTime                 @default(now()) @db.Timestamp(6)
  match_correction       match_correction[]
  usr_user               usr_user                 @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_master_created_by")
  mst_sport_format       mst_sport_format?        @relation(fields: [format_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_master_format")
  mst_sport_scoring      mst_sport_scoring?       @relation(fields: [scoring_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_master_scoring")
  mst_sport              mst_sport                @relation(fields: [sport_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_master_sport")
  match_participant      match_participant[]
  match_period           match_period[]
  match_report           match_report[]
  match_result           match_result?
  match_score_event      match_score_event[]
  match_score_state      match_score_state[]
  match_stat_snapshot    match_stat_snapshot[]
  match_team             match_team[]
  usr_sport_stat_history usr_sport_stat_history[]
}

model match_participant {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  match_id            String                @db.Uuid
  user_id             String                @db.Uuid
  participant_type_id BigInt?
  participant_no      Int
  status_id           BigInt?
  joined_at           DateTime              @default(now()) @db.Timestamp(6)
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  updated_at          DateTime              @default(now()) @db.Timestamp(6)
  match_master        match_master          @relation(fields: [match_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_participant_match")
  usr_user            usr_user              @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_participant_user")
  match_result        match_result[]
  match_score_event   match_score_event[]
  match_score_state   match_score_state[]
  match_stat_snapshot match_stat_snapshot[]
  match_team_member   match_team_member[]

  @@unique([match_id, participant_no], map: "uq_match_participant_no")
  @@unique([match_id, user_id], map: "uq_match_participant_user")
}

model match_period {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  match_id          String              @db.Uuid
  period_no         Int
  period_type_id    BigInt?
  status_id         BigInt?
  started_at        DateTime?           @db.Timestamp(6)
  completed_at      DateTime?           @db.Timestamp(6)
  created_at        DateTime            @default(now()) @db.Timestamp(6)
  updated_at        DateTime            @default(now()) @db.Timestamp(6)
  match_master      match_master        @relation(fields: [match_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_period_match")
  match_score_event match_score_event[]
  match_score_state match_score_state[]

  @@unique([match_id, period_no], map: "uq_match_period_no")
}

model match_report {
  id                                          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporter_id                                 String       @db.Uuid
  match_id                                    String       @db.Uuid
  report_type_id                              BigInt
  description                                 String?
  status_id                                   BigInt
  resolved_by                                 String?      @db.Uuid
  resolved_at                                 DateTime?    @db.Timestamp(6)
  created_at                                  DateTime     @default(now()) @db.Timestamp(6)
  updated_at                                  DateTime     @default(now()) @db.Timestamp(6)
  match_master                                match_master @relation(fields: [match_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_report_match")
  usr_user_match_report_reporter_idTousr_user usr_user     @relation("match_report_reporter_idTousr_user", fields: [reporter_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_report_reporter")
  usr_user_match_report_resolved_byTousr_user usr_user?    @relation("match_report_resolved_byTousr_user", fields: [resolved_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_report_resolved_by")
}

model match_result {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  match_id              String             @unique(map: "uq_match_result_match") @db.Uuid
  winner_participant_id String?            @db.Uuid
  winner_team_id        String?            @db.Uuid
  result_type_id        BigInt?
  result_data           Json?
  completed_at          DateTime           @default(now()) @db.Timestamp(6)
  created_at            DateTime           @default(now()) @db.Timestamp(6)
  match_master          match_master       @relation(fields: [match_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_result_match")
  match_participant     match_participant? @relation(fields: [winner_participant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_result_winner_participant")
  match_team            match_team?        @relation(fields: [winner_team_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_result_winner_team")
}

model match_score_event {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  match_id          String              @db.Uuid
  period_id         String?             @db.Uuid
  participant_id    String?             @db.Uuid
  team_id           String?             @db.Uuid
  event_type_id     BigInt
  sequence_no       Int
  score_value       Decimal?            @default(0) @db.Decimal(10, 2)
  event_data        Json?
  is_undone         Boolean             @default(false)
  created_by        String              @db.Uuid
  created_at        DateTime            @default(now()) @db.Timestamp(6)
  match_correction  match_correction?
  usr_user          usr_user            @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_score_event_created_by")
  match_master      match_master        @relation(fields: [match_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_score_event_match")
  match_participant match_participant?  @relation(fields: [participant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_score_event_participant")
  match_period      match_period?       @relation(fields: [period_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_score_event_period")
  match_team        match_team?         @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_score_event_team")
  match_score_state match_score_state[]

  @@unique([match_id, sequence_no], map: "uq_match_score_event_sequence")
}

model match_score_state {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  match_id          String             @db.Uuid
  period_id         String?            @db.Uuid
  participant_id    String?            @db.Uuid
  team_id           String?            @db.Uuid
  score_value       Decimal            @default(0) @db.Decimal(10, 2)
  state_data        Json?
  last_event_id     String?            @db.Uuid
  updated_at        DateTime           @default(now()) @db.Timestamp(6)
  match_score_event match_score_event? @relation(fields: [last_event_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_score_state_event")
  match_master      match_master       @relation(fields: [match_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_score_state_match")
  match_participant match_participant? @relation(fields: [participant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_score_state_participant")
  match_period      match_period?      @relation(fields: [period_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_score_state_period")
  match_team        match_team?        @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_score_state_team")
}

model match_stat_snapshot {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  match_id                   String                       @db.Uuid
  participant_id             String                       @db.Uuid
  sport_id                   BigInt
  stat_data                  Json
  created_at                 DateTime                     @default(now()) @db.Timestamp(6)
  match_master               match_master                 @relation(fields: [match_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_stat_snapshot_match")
  match_participant          match_participant            @relation(fields: [participant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_stat_snapshot_participant")
  mst_sport                  mst_sport                    @relation(fields: [sport_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_stat_snapshot_sport")
  match_stat_snapshot_detail match_stat_snapshot_detail[]

  @@unique([match_id, participant_id], map: "uq_match_stat_snapshot")
}

model match_stat_snapshot_detail {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  snapshot_id         String              @db.Uuid
  stat_type_id        BigInt
  stat_value          Decimal             @default(0) @db.Decimal(18, 4)
  created_at          DateTime            @default(now()) @db.Timestamp(6)
  match_stat_snapshot match_stat_snapshot @relation(fields: [snapshot_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_match_stat_snapshot_detail_snapshot")

  @@unique([snapshot_id, stat_type_id], map: "uq_match_stat_snapshot_detail")
}

model match_team {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  match_id          String              @db.Uuid
  team_no           Int
  team_name         String?             @db.VarChar(150)
  created_at        DateTime            @default(now()) @db.Timestamp(6)
  updated_at        DateTime            @default(now()) @db.Timestamp(6)
  match_result      match_result[]
  match_score_event match_score_event[]
  match_score_state match_score_state[]
  match_master      match_master        @relation(fields: [match_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_team_match")
  match_team_member match_team_member[]

  @@unique([match_id, team_no], map: "uq_match_team_no")
}

model match_team_member {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  team_id           String            @db.Uuid
  participant_id    String            @db.Uuid
  member_no         Int
  created_at        DateTime          @default(now()) @db.Timestamp(6)
  updated_at        DateTime          @default(now()) @db.Timestamp(6)
  match_participant match_participant @relation(fields: [participant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_team_member_participant")
  match_team        match_team        @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_match_team_member_team")

  @@unique([team_id, participant_id], map: "uq_match_team_member")
  @@unique([team_id, member_no], map: "uq_match_team_member_no")
}

model media_asset {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploaded_by   String   @db.Uuid
  media_type_id BigInt
  storage_key   String
  media_url     String?
  file_name     String?  @db.VarChar(255)
  mime_type     String?  @db.VarChar(100)
  file_size     BigInt?
  width         Int?
  height        Int?
  duration      Decimal? @db.Decimal(10, 2)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  usr_user      usr_user @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_media_asset_uploaded_by")
}

model mst_sport {
  id                     BigInt                   @id @default(autoincrement())
  code                   String                   @unique(map: "uq_mst_sport_code") @db.VarChar(50)
  name                   String                   @unique(map: "uq_mst_sport_name") @db.VarChar(100)
  description            String?                  @db.VarChar(500)
  admin_analytics_daily  admin_analytics_daily[]
  match_master           match_master[]
  match_stat_snapshot    match_stat_snapshot[]
  mst_sport_event        mst_sport_event[]
  mst_sport_format       mst_sport_format[]
  mst_sport_period       mst_sport_period[]
  mst_sport_rule         mst_sport_rule[]
  mst_sport_scoring      mst_sport_scoring[]
  mst_sport_stat         mst_sport_stat[]
  usr_sport_rating       usr_sport_rating[]
  usr_sport_stat_history usr_sport_stat_history[]
  usr_sport_stats        usr_sport_stats[]
  usr_user_sport         usr_user_sport[]
}

model mst_sport_event {
  id            BigInt      @id @default(autoincrement())
  sport_id      BigInt
  event_type_id BigInt
  name          String      @db.VarChar(100)
  description   String?     @db.VarChar(500)
  event_config  Json        @default("{}")
  mst_sport     mst_sport   @relation(fields: [sport_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sport_event_sport")
  type_master   type_master @relation(fields: [event_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sport_event_type")

  @@unique([sport_id, event_type_id], map: "uq_sport_event")
}

model mst_sport_format {
  id                BigInt              @id @default(autoincrement())
  sport_id          BigInt
  format_type_id    BigInt
  name              String              @db.VarChar(100)
  description       String?             @db.VarChar(500)
  min_players       Int?                @db.SmallInt
  max_players       Int?                @db.SmallInt
  match_master      match_master[]
  mst_sport         mst_sport           @relation(fields: [sport_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sport_format_sport")
  type_master       type_master         @relation(fields: [format_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sport_format_type")
  mst_sport_scoring mst_sport_scoring[]

  @@unique([sport_id, format_type_id], map: "uq_sport_format")
}

model mst_sport_period {
  id             BigInt      @id @default(autoincrement())
  sport_id       BigInt
  period_type_id BigInt
  name           String      @db.VarChar(100)
  sequence_no    Int?        @db.SmallInt
  config         Json        @default("{}")
  mst_sport      mst_sport   @relation(fields: [sport_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sport_period_sport")
  type_master    type_master @relation(fields: [period_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sport_period_type")

  @@unique([sport_id, period_type_id, sequence_no], map: "uq_sport_period")
}

model mst_sport_rule {
  id         BigInt    @id @default(autoincrement())
  sport_id   BigInt
  rule_code  String    @db.VarChar(100)
  rule_name  String    @db.VarChar(255)
  rule_value Json?
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime  @default(now()) @db.Timestamp(6)
  mst_sport  mst_sport @relation(fields: [sport_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mst_sport_rule_sport")

  @@unique([sport_id, rule_code], map: "uq_mst_sport_rule_code")
}

model mst_sport_scoring {
  id               BigInt            @id @default(autoincrement())
  sport_id         BigInt
  format_id        BigInt?
  scoring_type_id  BigInt
  scoring_config   Json              @default("{}")
  match_master     match_master[]
  mst_sport_format mst_sport_format? @relation(fields: [format_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sport_scoring_format")
  mst_sport        mst_sport         @relation(fields: [sport_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sport_scoring_sport")
  type_master      type_master       @relation(fields: [scoring_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sport_scoring_type")

