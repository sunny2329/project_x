# Copy to .env and fill in. Never commit .env.

NODE_ENV=development            # development | test | production
PORT=4000
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent
TRUST_PROXY=0                   # number of reverse proxies in front of the API (e.g. 1 behind a load balancer)
CORS_ORIGINS=                   # comma-separated browser origins; empty = none (mobile apps don't need CORS)

# Neon: pooled URL (host contains "-pooler") for the API, direct URL for migrations and tests.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/project_x?sslmode=verify-full
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/project_x?sslmode=verify-full

# Redis for live match scores (Upstash, region ap-south-1 / Mumbai). Use the rediss:// (TLS) URL.
# Leave empty to keep live state in process memory (single server, development only).
REDIS_URL=
DB_POOL_MAX=10

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# twilio = codes sent by SMS through Twilio (TWILIO_FROM_NUMBER = your Twilio phone number, E.164).
# dev = no SMS; every code is DEV_OTP_CODE (rejected in production).
SMS_PROVIDER=twilio
DEV_OTP_CODE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Comma-separated. Google: the OAuth *Web* client ID used by the app as webClientId.
GOOGLE_CLIENT_IDS=
# Comma-separated iOS bundle identifiers allowed as the Apple token audience.
APPLE_BUNDLE_IDS=
